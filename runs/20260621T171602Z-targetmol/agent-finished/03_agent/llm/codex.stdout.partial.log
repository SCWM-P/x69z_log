{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /app/targetmol/offline_eval.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Local evaluator proxy for targetMOL submissions.\n\nThe official evaluator is hidden. This module deliberately uses transparent\ntiers so failures can be inspected: contract/route checks, ligand prep checks,\nand optional Vina docking proxy checks against a public or mounted PDB panel.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport json\nimport math\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom collections import Counter\nfrom pathlib import Path\n\nfrom common import EXPECTED_MEMBERS, read_submission, utc_now, write_json\n\n\ndef route_issues(row: dict[str, str]) -> list[str]:\n    from rdkit import Chem\n\n    issues: list[str] = []\n    final_product = row[\"route\"].split(\",\")[-1].split(\">>\")[-1]\n    if final_product != row[\"mol_smiles\"]:\n        issues.append(\"final_product_mismatch\")\n    for step_index, step in enumerate(row[\"route\"].split(\",\"), start=1):\n        if \">>\" not in step:\n            issues.append(f\"step_{step_index}_missing_arrow\")\n            continue\n        left, product_text = step.split(\">>\", 1)\n        reactant_texts = [part for part in left.split(\".\") if part]\n        if product_text in reactant_texts:\n            issues.append(f\"step_{step_index}_product_is_reactant\")\n        product = Chem.MolFromSmiles(product_text)\n        reactants = [Chem.MolFromSmiles(part) for part in reactant_texts]\n        if product is None or not reactants or any(mol is None for mol in reactants):\n            issues.append(f\"step_{step_index}_invalid_smiles\")\n            continue\n        product_counts: Counter[str] = Counter(atom.GetSymbol() for atom in product.GetAtoms())\n        reactant_counts: Counter[str] = Counter(\n            atom.GetSymbol() for molecule in reactants for atom in molecule.GetAtoms()\n        )\n        for element, count in product_counts.items():\n            if reactant_counts[element] < count:\n                issues.append(f\"step_{step_index}_element_not_covered:{element}\")\n    return issues\n\n\ndef molecule_metrics(smiles: str) -> dict[str, object]:\n    from rdkit import Chem\n    from rdkit.Chem import Crippen, Descriptors, Lipinski, QED, rdMolDescriptors\n\n    molecule = Chem.MolFromSmiles(smiles)\n    if molecule is None:\n        raise ValueError(\"SMILES parse failed\")\n    Chem.SanitizeMol(molecule)\n    metrics: dict[str, object] = {\n        \"canonical\": Chem.MolToSmiles(molecule, canonical=True),\n        \"mw\": float(Descriptors.MolWt(molecule)),\n        \"logp\": float(Crippen.MolLogP(molecule)),\n        \"tpsa\": float(rdMolDescriptors.CalcTPSA(molecule)),\n        \"qed\": float(QED.qed(molecule)),\n        \"rotors\": int(Lipinski.NumRotatableBonds(molecule)),\n        \"rings\": int(rdMolDescriptors.CalcNumRings(molecule)),\n        \"aromatic_rings\": int(rdMolDescriptors.CalcNumAromaticRings(molecule)),\n        \"heavy_atoms\": int(molecule.GetNumHeavyAtoms()),\n        \"hbd\": int(Lipinski.NumHDonors(molecule)),\n        \"hba\": int(Lipinski.NumHAcceptors(molecule)),\n    }\n    try:\n        from rdkit.Chem import RDConfig\n\n        sa_path = Path(RDConfig.RDContribDir) / \"SA_Score\"\n        if str(sa_path) not in sys.path:\n            sys.path.append(str(sa_path))\n        import sascorer\n\n        metrics[\"sa\"] = float(sascorer.calculateScore(molecule))\n    except Exception:\n        metrics[\"sa\"] = None\n    return metrics\n\n\ndef risk_flags(metrics: dict[str, object], route_len: int) -> list[str]:\n    flags: list[str] = []\n    if float(metrics[\"mw\"]) > 700:\n        flags.append(\"mw_gt_700\")\n    if float(metrics[\"logp\"]) > 8.5:\n        flags.append(\"logp_gt_8_5\")\n    if not 20 <= float(metrics[\"tpsa\"]) <= 150:\n        flags.append(\"tpsa_outside_20_150\")\n    if int(metrics[\"rotors\"]) > 10:\n        flags.append(\"rotors_gt_10\")\n    if int(metrics[\"rings\"]) > 8:\n        flags.append(\"rings_gt_8\")\n    if int(metrics[\"heavy_atoms\"]) > 58:\n        flags.append(\"heavy_atoms_gt_58\")\n    if route_len > 255:\n        flags.append(\"route_len_gt_255\")\n    sa = metrics.get(\"sa\")\n    if sa is not None and float(sa) > 4.9:\n        flags.append(\"sa_gt_4_9\")\n    return flags\n\n\ndef clamp(value: float, lower: float = 0.0, upper: float = 100.0) -> float:\n    return max(lower, min(upper, value))\n\n\ndef route_step_count(route: str) -> int:\n    return sum(1 for step in route.split(\",\") if step.strip())\n\n\ndef route_reactant_count(route: str) -> int:\n    count = 0\n    for step in route.split(\",\"):\n        if \">>\" not in step:\n            continue\n        left, _product = step.split(\">>\", 1)\n        count += sum(1 for part in left.split(\".\") if part)\n    return count\n\n\ndef official_proxy_components(\n    metrics: dict[str, object],\n    flags: list[str],\n    route_issues_list: list[str],\n    route: str,\n    affinity: float | None,\n) -> dict[str, float]:\n    \"\"\"Return transparent proxies using the official FAQ field names.\n\n    These are not hidden-official evaluator values. They keep our local report\n    aligned with the public scoring vocabulary so each loss source can be\n    inspected in the same dimensions as the competition rubric.\n    \"\"\"\n\n    sa = float(metrics[\"sa\"]) if metrics.get(\"sa\") is not None else 3.5\n    steps = route_step_count(route)\n    reactants = route_reactant_count(route)\n    route_len = len(route)\n\n    # The public FAQ says binding is Vina based. Without tier-2 docking we keep\n    # a neutral 55 baseline; with affinity, more negative Vina affinity helps.\n    binding_score = clamp(55.0 if affinity is None else 55.0 + clamp(-2.5 * affinity, -25.0, 25.0))\n    validity_score = clamp(100.0 - 18.0 * len(flags))\n    sa_score = clamp(100.0 - 20.0 * max(0.0, sa - 1.0))\n\n    route_validity_score = clamp(100.0 - 25.0 * len(route_issues_list))\n\n    # We do not have the official starting-material database. This proxy rewards\n    # concise routes with fewer starting reactants while still exposing the field\n    # name that should be replaced by a real availability lookup later.\n    if route_issues_list:\n        starting_material_availability_score = 0.0\n    else:\n        starting_material_availability_score = clamp(100.0 - 4.0 * max(0, reactants - steps) - 0.06 * max(0, route_len - 120))\n\n    step_penalty_score = clamp(100.0 - 8.0 * max(0, steps - 1))\n    convergence_score = 100.0 if any(\".\" in step.split(\">>\", 1)[0] for step in route.split(\",\") if \">>\" in step) else 65.0\n\n    balance_blockers = [issue for issue in route_issues_list if \"element_not_covered\" in issue or \"product_is_reactant\" in issue]\n    balance_score = 0.0 if balance_blockers else route_validity_score\n\n    molecule_score = 0.8 * binding_score + 0.1 * validity_score + 0.1 * sa_score\n    synthesis_route_score = (\n        0.55 * route_validity_score\n        + 0.30 * starting_material_availability_score\n        + 0.05 * step_penalty_score\n        + 0.05 * convergence_score\n        + 0.05 * balance_score\n    )\n    official_weighted_proxy_score = 0.7 * molecule_score + 0.3 * synthesis_route_score\n\n    return {\n        \"binding_score\": round(binding_score, 4),\n        \"validity_score\": round(validity_score, 4),\n        \"sa_score\": round(sa_score, 4),\n        \"molecule_score\": round(molecule_score, 4),\n        \"route_validity_score\": round(route_validity_score, 4),\n        \"starting_material_availability_score\": round(starting_material_availability_score, 4),\n        \"step_penalty_score\": round(step_penalty_score, 4),\n        \"convergence_score\": round(convergence_score, 4),\n        \"balance_score\": round(balance_score, 4),\n        \"synthesis_route_score\": round(synthesis_route_score, 4),\n        \"official_weighted_proxy_score\": round(official_weighted_proxy_score, 4),\n    }\n\n\ndef embed_and_convert(smiles: str, temp: Path, timeout: int) -> dict[str, object]:\n    from rdkit import Chem\n    from rdkit.Chem import AllChem\n\n    started = time.monotonic()\n    molecule = Chem.MolFromSmiles(smiles)\n    if molecule is None:\n        raise ValueError(\"SMILES parse failed\")\n    embedded = Chem.AddHs(molecule)\n    params = AllChem.ETKDGv3()\n    params.randomSeed = 0xC0FFEE\n    status = AllChem.EmbedMolecule(embedded, params)\n    if status != 0:\n        raise ValueError(f\"ETKDG failed with status {status}\")\n    try:\n        AllChem.UFFOptimizeMolecule(embedded, maxIters=80)\n    except Exception:\n        pass\n    sdf = temp / \"ligand.sdf\"\n    pdbqt = temp / \"ligand.pdbqt\"\n    writer = Chem.SDWriter(str(sdf))\n    writer.write(embedded)\n    writer.close()\n    obabel = next((p for p in (\"/opt/conda/bin/obabel\", \"obabel\") if shutil_which(p)), None)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /app/targetmol/common.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /app/targetmol/common.py\"","aggregated_output":"#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport csv\nimport hashlib\nimport json\nimport os\nimport re\nimport shutil\nimport tempfile\nimport zipfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nEXPECTED_MEMBERS = [\"result1.csv\", \"result2.csv\", \"result3.csv\", \"result.log\"]\n# Stage-2 public rank telemetry shows the leading target-molecule submissions\n# use one final molecule per target. Keep the upper bound at 5 for local\n# ablations and legacy inspection, but default the competition contract to 1.\nDEFAULT_ROWS_PER_TARGET = 1\nMAX_ROWS_PER_TARGET = 5\nSECRET_NAMES = (\n    \"OPENAI_API_KEY\",\n    \"ANTHROPIC_AUTH_TOKEN\",\n    \"DASEINAI_API_KEY\",\n    \"ZHIPUAI_API_KEY\",\n    \"NVIDIA_DIFFDOCK_KEY\",\n    \"NVIDIA_API_KEY\",\n    \"KEY_NAME\",\n    \"NVIDIA_DIFFDOCK_KEY_NAME\",\n    \"GITLAB_TOKEN\",\n    \"GITLAB_PERSONAL_TOKEN\",\n    \"GL_TOKEN\",\n    \"GITHUB_TOKEN\",\n    \"GH_TOKEN\",\n)\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\n\n\ndef append_jsonl(path: Path, payload: dict[str, object]) -> None:\n    event = {\"ts\": utc_now(), **payload}\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"a\", encoding=\"utf-8\") as handle:\n        handle.write(redact_text(json.dumps(event, sort_keys=True, ensure_ascii=False)) + \"\\n\")\n\n\ndef rows_per_target() -> int:\n    raw = os.environ.get(\"TARGETMOL_ROWS_PER_TARGET\", str(DEFAULT_ROWS_PER_TARGET))\n    try:\n        value = int(raw)\n    except ValueError:\n        value = DEFAULT_ROWS_PER_TARGET\n    return max(1, min(MAX_ROWS_PER_TARGET, value))\n\n\ndef load_runtime_secrets(path: Path = Path(\"/app/targetmol/runtime_secrets.json\")) -> list[str]:\n    if not path.is_file():\n        return []\n    payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    loaded = []\n    for name in SECRET_NAMES:\n        value = payload.get(name)\n        if isinstance(value, str) and value:\n            os.environ[name] = value\n            loaded.append(name)\n    for name in (\n        \"TARGETMOL_GITLAB_REPOSITORY\",\n        \"TARGETMOL_GITHUB_REPOSITORY\",\n        \"TARGETMOL_GITHUB_SSH_KEY_PATH\",\n        \"TARGETMOL_AGENT_PROVIDER\",\n        \"TARGETMOL_LITELLM_MODEL\",\n        \"TARGETMOL_DASEINAI_MODEL\",\n        \"TARGETMOL_OPENAI_MODEL\",\n        \"TARGETMOL_NVIDIA_DIFFDOCK_ENDPOINT\",\n    ):\n        value = payload.get(name)\n        if isinstance(value, str) and value:\n            os.environ[name] = value\n            loaded.append(name)\n    github_key = payload.get(\"TARGETMOL_GITHUB_SSH_PRIVATE_KEY\")\n    github_key_path = payload.get(\"TARGETMOL_GITHUB_SSH_KEY_PATH\") or \"/app/targetmol/github_ssh_key\"\n    if isinstance(github_key, str) and github_key.strip():\n        key_path = Path(str(github_key_path))\n        key_path.write_text(github_key, encoding=\"utf-8\")\n        key_path.chmod(0o400)\n        os.environ[\"TARGETMOL_GITHUB_SSH_KEY_PATH\"] = str(key_path)\n        loaded.append(\"TARGETMOL_GITHUB_SSH_PRIVATE_KEY\")\n    return loaded\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef redact_text(text: str) -> str:\n    redacted = text\n    for name in SECRET_NAMES:\n        value = os.environ.get(name)\n        if value:\n            redacted = redacted.replace(value, f\"<redacted:{name}>\")\n    redacted = re.sub(\n        r\"(?i)(authorization\\s*:\\s*bearer\\s+)[^\\s\\\"']+\",\n        r\"\\1<redacted>\",\n        redacted,\n    )\n    redacted = re.sub(\n        r\"(?i)(https?://[^/\\s:@]+:)[^@\\s/]+@\",\n        r\"\\1<redacted>@\",\n        redacted,\n    )\n    return redacted\n\n\ndef write_json(path: Path, payload: object) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(\n        redact_text(json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False)) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n\n\ndef read_submission(path: Path) -> tuple[dict[str, list[dict[str, str]]], str]:\n    if not path.is_file() or not zipfile.is_zipfile(path):\n        raise ValueError(f\"not a valid zip: {path}\")\n    tables: dict[str, list[dict[str, str]]] = {}\n    with zipfile.ZipFile(path) as archive:\n        if archive.namelist() != EXPECTED_MEMBERS:\n            raise ValueError(f\"unexpected zip members: {archive.namelist()}\")\n        for name in EXPECTED_MEMBERS[:3]:\n            text = archive.read(name).decode(\"utf-8\")\n            reader = csv.DictReader(text.splitlines())\n            if reader.fieldnames != [\"mol_smiles\", \"route\"]:\n                raise ValueError(f\"{name}: unexpected fields {reader.fieldnames}\")\n            rows = list(reader)\n            max_rows = rows_per_target()\n            if not 1 <= len(rows) <= max_rows:\n                raise ValueError(f\"{name}: expected 1..{max_rows} rows, got {len(rows)}\")\n            if len({row[\"mol_smiles\"] for row in rows}) != len(rows):\n                raise ValueError(f\"{name}: molecules are not unique\")\n            for row in rows:\n                if not row[\"route\"] or \">>\" not in row[\"route\"]:\n                    raise ValueError(f\"{name}: malformed route\")\n                product = row[\"route\"].split(\",\")[-1].split(\">>\")[-1]\n                if product != row[\"mol_smiles\"]:\n                    raise ValueError(f\"{name}: route final product mismatch\")\n            tables[name] = rows\n        log_text = archive.read(\"result.log\").decode(\"utf-8\", errors=\"replace\")\n    return tables, log_text\n\n\ndef write_submission(\n    destination: Path,\n    tables: dict[str, list[dict[str, str]]],\n    log_text: str,\n) -> None:\n    destination.parent.mkdir(parents=True, exist_ok=True)\n    with tempfile.TemporaryDirectory(prefix=\"targetmol-package-\") as temp_dir:\n        root = Path(temp_dir)\n        for name in EXPECTED_MEMBERS[:3]:\n            with (root / name).open(\"w\", encoding=\"utf-8\", newline=\"\") as handle:\n                writer = csv.DictWriter(handle, fieldnames=[\"mol_smiles\", \"route\"])\n                writer.writeheader()\n                writer.writerows(tables[name])\n        (root / \"result.log\").write_text(redact_text(log_text), encoding=\"utf-8\", newline=\"\\n\")\n        local_zip = root / \"result.zip\"\n        with zipfile.ZipFile(local_zip, \"w\", compression=zipfile.ZIP_DEFLATED) as archive:\n            for name in EXPECTED_MEMBERS:\n                archive.write(root / name, arcname=name)\n        read_submission(local_zip)\n        with local_zip.open(\"rb\") as source, destination.open(\"wb\") as target:\n            shutil.copyfileobj(source, target, length=1024 * 1024)\n            target.flush()\n            os.fsync(target.fileno())\n    read_submission(destination)\n","exit_code":0,"status":"completed"}}

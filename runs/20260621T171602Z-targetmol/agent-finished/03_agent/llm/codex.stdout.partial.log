{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The recovered metadata already maps the stripped proteins to MCL1, TYK2 JH2, and GPR119, and notes no co-crystal HETATM ligands in the mounted files. I’m independently checking compact structural summaries and then I’ll pull concise public ligand-family evidence for each target."}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"/opt/conda/bin/python - <<'PY'\nfrom pathlib import Path\nfrom collections import defaultdict, Counter\npdbs=[Path('/saisdata/target1.pdb'),Path('/saisdata/target2.pdb'),Path('/saisdata/target3.pdb')]\nstd={'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLU':'E','GLN':'Q','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V','SEC':'U','PYL':'O'}\nfor i,p in enumerate(pdbs,1):\n    chains=defaultdict(dict); het=Counter(); atoms=0; hetatoms=0; model_count=0\n    header=[]\n    with p.open('rt', errors='replace') as fh:\n        for line in fh:\n            rec=line[:6].strip()\n            if rec=='MODEL': model_count+=1\n            if rec=='ATOM':\n                atoms+=1\n                resn=line[17:20].strip(); ch=line[21].strip() or '_'; resi=line[22:26].strip(); icode=line[26].strip()\n                chains[ch][(resi,icode)]=resn\n            elif rec=='HETATM':\n                hetatoms+=1\n                resn=line[17:20].strip(); ch=line[21].strip() or '_'\n                het[(resn,ch)]+=1\n            elif rec in {'HEADER','TITLE','COMPND','SOURCE','KEYWDS','EXPDTA','REMARK'} and len(header)<8:\n                # category only; not raw PDB body\n                header.append(rec)\n    print(f'target{i}: bytes={p.stat().st_size} atoms={atoms} hetatoms={hetatoms} models={model_count or 1}')\n    for ch, residues in sorted(chains.items()):\n        nums=[]; seq=[]\n        for (resi,icode), resn in sorted(residues.items(), key=lambda kv: (int(kv[0][0]) if kv[0][0].lstrip('-').isdigit() else 10**9, kv[0][1])):\n            nums.append(int(resi) if resi.lstrip('-').isdigit() else resi); seq.append(std.get(resn,'X'))\n        rng=(min(nums),max(nums)) if nums and all(isinstance(x,int) for x in nums) else ('?','?')\n        print(f'  chain {ch}: observed_residues={len(residues)} residue_range={rng[0]}-{rng[1]} sequence_md5_prefix={__import__(\\\"hashlib\\\").md5(\\\"\\\".join(seq).encode()).hexdigest()[:12]}')\n    if het:\n        print('  het_summary:', ', '.join(f'{k[0]}:{v}' for k,v in het.most_common(8)))\n    else:\n        print('  het_summary: none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

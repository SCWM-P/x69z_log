{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '220,360p' /app/targetmol/offline_eval.py\"","aggregated_output":"    obabel = next((p for p in (\"/opt/conda/bin/obabel\", \"obabel\") if shutil_which(p)), None)\n    if not obabel:\n        raise ValueError(\"OpenBabel executable not found\")\n    completed = subprocess.run(\n        [obabel, str(sdf), \"-O\", str(pdbqt)],\n        capture_output=True,\n        text=True,\n        timeout=timeout,\n        check=False,\n    )\n    if completed.returncode != 0 or not pdbqt.is_file() or pdbqt.stat().st_size <= 0:\n        raise ValueError((completed.stderr or \"OpenBabel conversion failed\")[-500:])\n    return {\n        \"elapsed_ms\": round((time.monotonic() - started) * 1000),\n        \"ligand_pdbqt\": str(pdbqt),\n    }\n\n\ndef shutil_which(command: str) -> str | None:\n    import shutil\n\n    if \"/\" in command and Path(command).exists():\n        return command\n    return shutil.which(command)\n\n\ndef target_box(pdb: Path) -> tuple[tuple[float, float, float], tuple[float, float, float]]:\n    het_points: list[tuple[float, float, float]] = []\n    atom_points: list[tuple[float, float, float]] = []\n    ignored = {\"HOH\", \"WAT\", \"DOD\", \"NA\", \"K\", \"CL\", \"CA\", \"MG\", \"ZN\", \"MN\", \"SO4\", \"PO4\"}\n    with pdb.open(errors=\"ignore\") as handle:\n        for line in handle:\n            if not line.startswith((\"ATOM\", \"HETATM\")):\n                continue\n            try:\n                point = (float(line[30:38]), float(line[38:46]), float(line[46:54]))\n            except ValueError:\n                continue\n            if line.startswith(\"HETATM\") and line[17:20].strip().upper() not in ignored:\n                het_points.append(point)\n            elif line.startswith(\"ATOM\"):\n                atom_points.append(point)\n    points = het_points or atom_points\n    if not points:\n        return (0.0, 0.0, 0.0), (24.0, 24.0, 24.0)\n    center = tuple(sum(p[i] for p in points) / len(points) for i in range(3))\n    if het_points:\n        size = (22.0, 22.0, 22.0)\n    else:\n        xs, ys, zs = zip(*points)\n        size = (\n            min(30.0, max(18.0, max(xs) - min(xs) + 8.0)),\n            min(30.0, max(18.0, max(ys) - min(ys) + 8.0)),\n            min(30.0, max(18.0, max(zs) - min(zs) + 8.0)),\n        )\n    return center, size\n\n\ndef prepare_receptor(pdb: Path, temp: Path, timeout: int) -> Path:\n    obabel = next((p for p in (\"/opt/conda/bin/obabel\", \"obabel\") if shutil_which(p)), None)\n    if not obabel:\n        raise ValueError(\"OpenBabel executable not found\")\n    receptor = temp / \"receptor.pdbqt\"\n    completed = subprocess.run(\n        [obabel, str(pdb), \"-xr\", \"-O\", str(receptor)],\n        capture_output=True,\n        text=True,\n        timeout=timeout,\n        check=False,\n    )\n    if completed.returncode != 0 or not receptor.is_file() or receptor.stat().st_size <= 0:\n        raise ValueError((completed.stderr or \"receptor conversion failed\")[-500:])\n    return receptor\n\n\ndef run_vina(pdb: Path, ligand_pdbqt: Path, temp: Path, timeout: int) -> dict[str, object]:\n    vina = next((p for p in (\"/opt/conda/bin/vina\", \"vina\") if shutil_which(p)), None)\n    if not vina:\n        raise ValueError(\"Vina executable not found\")\n    receptor = prepare_receptor(pdb, temp, min(timeout, 30))\n    center, size = target_box(pdb)\n    out = temp / \"dock_out.pdbqt\"\n    log = temp / \"vina.log\"\n    started = time.monotonic()\n    command = [\n        vina,\n        \"--receptor\",\n        str(receptor),\n        \"--ligand\",\n        str(ligand_pdbqt),\n        \"--center_x\",\n        f\"{center[0]:.3f}\",\n        \"--center_y\",\n        f\"{center[1]:.3f}\",\n        \"--center_z\",\n        f\"{center[2]:.3f}\",\n        \"--size_x\",\n        f\"{size[0]:.3f}\",\n        \"--size_y\",\n        f\"{size[1]:.3f}\",\n        \"--size_z\",\n        f\"{size[2]:.3f}\",\n        \"--exhaustiveness\",\n        \"2\",\n        \"--num_modes\",\n        \"1\",\n        \"--out\",\n        str(out),\n    ]\n    completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)\n    log.write_text(completed.stdout + completed.stderr, encoding=\"utf-8\", errors=\"replace\")\n    affinity = None\n    for line in completed.stdout.splitlines():\n        parts = line.split()\n        if len(parts) >= 2 and parts[0] == \"1\":\n            try:\n                affinity = float(parts[1])\n            except ValueError:\n                pass\n    if completed.returncode != 0:\n        raise ValueError((completed.stderr or \"vina failed\")[-500:])\n    return {\n        \"elapsed_ms\": round((time.monotonic() - started) * 1000),\n        \"affinity\": affinity,\n        \"center\": [round(v, 3) for v in center],\n        \"size\": [round(v, 3) for v in size],\n    }\n\n\ndef descriptor_balance_adjustment(metrics: dict[str, object]) -> float:\n    qed = float(metrics[\"qed\"])\n    mw = float(metrics[\"mw\"])\n    logp = float(metrics[\"logp\"])\n    tpsa = float(metrics[\"tpsa\"])\n    return 10.0 * qed - 0.06 * abs(mw - 540.0) - 1.2 * abs(logp - 7.2) - 0.05 * abs(tpsa - 55.0)\n\n\ndef proxy_score(metrics: dict[str, object], flags: list[str], route_issues_count: int, affinity: float | None) -> float:\n    route = str(metrics.get(\"route\", \"\"))\n    route_issues_list = list(metrics.get(\"route_issues\", []))\n    if not route_issues_list and route_issues_count:\n","exit_code":0,"status":"completed"}}

        "permission_groups": [
          "human-approved-codex-or-claude-tools"
        ]
      },
      "label": "Principal Investigator",
      "risk": {
        "human_gated": []
      },
      "tools": {
        "allow": [
          "runtime.init",
          "runtime.status",
          "runtime.dashboard",
          "context.policy",
          "context.node_rule",
          "context.role",
          "context.launch",
          "context.intro",
          "lab.recruit",
          "lab.dismiss",
          "node.add",
          "node.edit",
          "node.remove"
        ],
        "deny": []
      },
      "workspace": {
        "scope": "runtime-and-authorized-workspaces"
      }
    },
    "adversary": {
      "extends": "runtime_reader",
      "host": {
        "permission_groups": []
      },
      "label": "Adversarial Critic",

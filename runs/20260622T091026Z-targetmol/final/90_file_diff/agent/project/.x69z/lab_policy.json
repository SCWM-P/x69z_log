        "human_gated": []
      },
      "tools": {
        "allow": [
          "runtime.dashboard"
        ],
        "deny": []
      },
      "workspace": {
        "scope": "runtime"
      }
    },
    "runtime_reader": {
      "host": {
        "permission_groups": []
      },
      "label": "Runtime Reader",
      "risk": {
        "human_gated": []

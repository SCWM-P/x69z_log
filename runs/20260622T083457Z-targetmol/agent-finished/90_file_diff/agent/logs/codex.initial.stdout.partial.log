{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nthree = {\n'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V','MSE':'M','SEC':'U','PYL':'O','ASX':'B','GLX':'Z','UNK':'X'}\nfor p in sorted(Path('input_targets').glob('target*.pdb')):\n    chains={}\n    het=[]\n    residues_seen=set()\n    atom_count=0\n    for line in p.open():\n        rec=line[:6].strip()\n        if rec=='ATOM':\n            atom_count+=1\n            chain=line[21].strip() or '_'\n            resn=line[17:20].strip()\n            resseq=line[22:26].strip()+line[26].strip()\n            key=(chain,resseq,resn)\n            if key not in residues_seen:\n                residues_seen.add(key)\n                chains.setdefault(chain,[]).append((resseq,resn,three.get(resn,'X')))\n        elif rec=='HETATM':\n            resn=line[17:20].strip(); chain=line[21].strip() or '_'; resseq=line[22:26].strip()+line[26].strip()\n            if resn not in {'HOH','WAT'}:\n                het.append((resn,chain,resseq))\n    print('\\\\n',p.name,'atoms',atom_count)\n    for ch,res in chains.items():\n        seq=''.join(r[2] for r in res)\n        print(' chain',ch,'len',len(seq),'range',res[0][0]+'-'+res[-1][0],'first',seq[:80],'last',seq[-80:])\n    print(' hetero unique', sorted(set(het))[:40], 'count', len(het))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
